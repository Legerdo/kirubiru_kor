{
  "name": "kirubiru-web",
  "version": "1.0.0",
  "private": true,
  "description": "Unofficial web port of Kirubiru with preserved Korean assets and statically reconstructed game logic",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5298 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5298 --strictPort",
    "assets": "python tools/prepare-assets.py",
    "native": "python tools/build-native.py",
    "verify": "node tools/verify.mjs",
    "test:standalone": "node tools/standalone-qa.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "webaudio-tinysynth": "1.1.3"
  },
  "devDependencies": { "typescript": "5.9.3", "vite": "7.1.7", "playwright": "1.56.1" }
}
